/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/opensearch -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Project-specific test data is not bundled yet.
    // Provide these on the command line or in a params file when running this profile.
    input              = null
    input_dir          = null
    fragpipe_workflow       = null
    fragpipe_database       = null
    fragpipe_tools_folder   = null
    fragpipe_diann           = null
    fragpipe_python          = null
    fragpipe_crystalc        = null
    fragpipe_allow_partial = true
    raw_pattern        = '*.raw'
}
