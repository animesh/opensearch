manifest {
    name            = 'nf-core/opensearch'
    author          = 'nf-core community'
    homePage        = 'https://github.com/nf-core/opensearch'
    description     = 'Open search proteomics workflow using FragPipe with optional Casanovo and AA_stat post-processing'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.2.0'
}

// Global parameters
// nextflow.config

params {
    version         = false
    email           = null
    email_on_fail   = null
    plaintext_email = false
    monochrome_logs = false

    input           = null
    input_dir       = null
    raw_pattern     = '*.d,*.raw,*.RAW,*.mzML,*.mzml'
    // FragPipe workflow is supplied directly from the FragPipe installation.
    fragpipe_workflow = "${projectDir}/fp.dl.workflow.txt"

    // Environment-specific FragPipe settings used by the workflow renderer and headless CLI.
    fragpipe_database      = "${System.getenv('HOME')}/fragpipe/2024-06-01-decoys-contam-UP000005640.fas"
    fragpipe_tools_folder  = "${System.getenv('HOME')}/fragpipe/tools"
    fragpipe_diann          = "${System.getenv('HOME')}/fragpipe/tools/diann/1.8.2_beta_8/linux/diann-1.8.1.8"
    fragpipe_python         = '/usr/bin/python3'
    fragpipe_crystalc       = null
    outdir          = './results'
    
    // Optional process execution flags
    run_casanovo    = true
    run_aa_stat     = true
    // Optional tools are independent of FragPipe success.
    fragpipe_allow_partial = true

    // Shared resource controls. These are per heavy-tool process.
    cpus = 20
    ram_gb = 40
    max_concurrent = 1

    // Binaries
    fragpipe_bin    = System.getenv('FRAGPIPE_BIN') ?: "${System.getenv('HOME')}/fragpipe/bin/fragpipe"
    aa_stat_bin     = System.getenv('AA_STAT_BIN')  ?: "${System.getenv('HOME')}/.local/bin/AA_stat"
    casanovo_bin    = System.getenv('CASANOVO_BIN') ?: "${System.getenv('HOME')}/.local/bin/casanovo"

    // Output directory suffixes used by the integrated reporting process.
    fragpipe_workdir_suffix = 'FPv24'
    casanovo_workdir_suffix = 'DN'
    aastat_workdir_suffix    = 'AA_statm'
}

// Config imports
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
}